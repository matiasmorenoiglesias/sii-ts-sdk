{
  "name": "sii-ts-sdk",
  "version": "0.0.1",
  "description": "Librería TypeScript para emitir boletas electrónicas al SII de Chile",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test",
    "typecheck": "tsc --noEmit",
    "try:certificate": "node --env-file=.env --import tsx examples/try-certificate.ts"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "fast-xml-parser": "^5.11.1",
    "node-forge": "^1.3.1",
    "xml-crypto": "^6.1.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/node-forge": "^1.3.11",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "xpath": "^0.0.34"
  },
  "engines": {
    "node": ">=20"
  }
}
