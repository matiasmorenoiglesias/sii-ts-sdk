# Copia este archivo a .env y complétalo con tu certificado real.
# .env está en .gitignore, nunca se sube.

SII_CERT_PATH=.local/mi-certificado.pfx
# Opcional: solo si tu .p12/.pfx tiene contraseña
SII_CERT_PASSWORD=

# Necesarios solo para examples/try-send.ts (emitir y enviar una boleta
# de prueba real contra el ambiente de certificación del SII).
SII_CAF_PATH=.local/mi-caf.xml
SII_ISSUER_LEGAL_NAME=
SII_ISSUER_BUSINESS_ACTIVITY=
# Fecha de la resolución que te autorizó a emitir boleta electrónica (AAAA-MM-DD)
SII_RESOLUTION_DATE=
# Por defecto 0, el valor fijo usado en el ambiente de certificación
SII_RESOLUTION_NUMBER=0
SII_TEST_FOLIO=1
SII_TEST_RECIPIENT_RUT=66666666-6
